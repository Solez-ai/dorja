{
  "name": "dorja",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,mobile \"pnpm --filter @dorja/api dev\" \"pnpm --filter @dorja/web dev\" \"pnpm --filter @dorja/mobile start\"",
    "dev:api": "pnpm --filter @dorja/api dev",
    "dev:web": "pnpm --filter @dorja/web dev",
    "dev:mobile": "pnpm --filter @dorja/mobile start",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @dorja/api prisma:migrate",
    "db:seed": "pnpm --filter @dorja/api prisma:seed",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.0"
  }
}
